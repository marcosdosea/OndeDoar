@model OndeDoarWeb.Models.InstituicaoViewModel

@{
    ViewData["Title"] = "Editar instituição";
}

<link rel="stylesheet" href="~/css/instituicao.css" asp-append-version="true" />

<div class="inst-cartao">
    <h1 class="inst-titulo">Editar instituição</h1>
    <p class="inst-subtitulo">Mantenha os dados atualizados.</p>

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="cad-campo">
            <label asp-for="NomeFantasia"></label>
            <input asp-for="NomeFantasia" class="form-control" />
            <span asp-validation-for="NomeFantasia" class="text-danger"></span>
        </div>

        <div class="cad-campo">
            <label asp-for="RazaoSocial"></label>
            <input asp-for="RazaoSocial" class="form-control" />
            <span asp-validation-for="RazaoSocial" class="text-danger"></span>
        </div>

        <div class="cad-grade-2">
            <div class="cad-campo">
                <label asp-for="Cnpj"></label>
                <input asp-for="Cnpj" class="form-control" maxlength="14" />
                <span asp-validation-for="Cnpj" class="text-danger"></span>
            </div>
            <div class="cad-campo">
                <label asp-for="Cep"></label>
                <input asp-for="Cep" class="form-control" maxlength="9" />
                <span asp-validation-for="Cep" class="text-danger"></span>
            </div>
        </div>

        <div class="cad-grade-2">
            <div class="cad-campo">
                <label asp-for="Cidade"></label>
                <input asp-for="Cidade" class="form-control" />
                <span asp-validation-for="Cidade" class="text-danger"></span>
            </div>
            <div class="cad-campo">
                <label asp-for="Estado"></label>
                <input asp-for="Estado" class="form-control" maxlength="2" />
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>
        </div>

        <div class="cad-grade-2">
            <div class="cad-campo">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="cad-campo">
                <label asp-for="Telefone"></label>
                <input asp-for="Telefone" class="form-control" maxlength="11" />
                <span asp-validation-for="Telefone" class="text-danger"></span>
            </div>
        </div>

        <div class="cad-grade-2">
            <div class="cad-campo">
                <label asp-for="HoraAbertura"></label>
                <input asp-for="HoraAbertura" type="time" class="form-control" />
                <span asp-validation-for="HoraAbertura" class="text-danger"></span>
            </div>
            <div class="cad-campo">
                <label asp-for="HoraFechamento"></label>
                <input asp-for="HoraFechamento" type="time" class="form-control" />
                <span asp-validation-for="HoraFechamento" class="text-danger"></span>
            </div>
        </div>

        <input type="submit" value="Salvar alterações" class="inst-btn inst-btn-primario inst-btn-bloco" />
        <a asp-action="Index" class="inst-btn inst-btn-contorno inst-btn-bloco">Cancelar</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="inst-btn inst-btn-perigo inst-btn-bloco">Excluir instituição</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}