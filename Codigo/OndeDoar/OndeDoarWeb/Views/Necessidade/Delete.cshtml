@model Models.NecessidadeViewModel

@{
    ViewData["Title"] = "Excluir necessidade";
}

@section Styles {
    <link rel="stylesheet" href="~/css/necessidade-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/necessidade-detalhe.css" asp-append-version="true" />
}

<div class="necessidades-page">
    <div class="necessidades-layout">
        <partial name="_MenuInstituicao" model="@("Necessidades")" />

        <main class="necessidades-main">
            <section class="painel-confirmacao" aria-labelledby="tituloExcluir">
                <svg class="alerta" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 7v6M12 17h.01" /></svg>
                <h1 id="tituloExcluir">Excluir necessidade?</h1>
                <p>Essa necessidade será removida do perfil público da instituição.<br />Essa ação não poderá ser desfeita.</p>

                <div class="modal-resumo">
                    <span class="card-icone" aria-hidden="true"><partial name="_IconeCategoria" model="@Model.Categoria" /></span>
                    <div>
                        <strong>@Model.Nome</strong>
                        <p>@Model.Categoria</p>
                        <span class="modal-status-rotulo">Status</span>
                        <span class="badge-status @(Model.Ativa ? "status-ativa" : "status-inativa")">@(Model.Ativa ? "Ativa" : "Inativa")</span>
                    </div>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="modal-botoes">
                    <a asp-action="Index" class="btn-contorno">Cancelar</a>
                    <button type="submit" class="btn-coral btn-com-icone">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M6 6l1 14h10l1-14" /><path d="M10 11v6M14 11v6" /></svg>
                        Excluir necessidade
                    </button>
                </form>
            </section>
        </main>
    </div>
</div>