@model IEnumerable<Models.NecessidadeViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Nome)</th>
            <th>@Html.DisplayNameFor(m => m.Categoria)</th>
            <th>@Html.DisplayNameFor(m => m.Prioridade)</th>
            <th>@Html.DisplayNameFor(m => m.Ativa)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(m => item.Nome)</td>
                <td>@Html.DisplayFor(m => item.Categoria)</td>
                <td>@Html.DisplayFor(m => item.Prioridade)</td>
                <td>@Html.DisplayFor(m => item.Ativa)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>