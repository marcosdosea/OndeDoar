@model IEnumerable<Models.NecessidadeViewModel>

@{
    ViewData["Title"] = "Necessidades";
    var lista = Model.ToList();
    var totalAtivas = lista.Count(n => n.Ativa);

    string ClassePrioridade(string p) => p switch { "Alta" => "alta", "Média" => "media", _ => "baixa" };
    string RotuloPrioridade(string p) => p switch
    {
        "Alta" => "Alta necessidade",
        "Média" => "Necessidade média",
        _ => "Necessidade baixa"
    };

    string IconePrioridade(string p) => p switch
    {
        "Alta" => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 16V8M8.5 11.5 12 8l3.5 3.5\"/>",
        "Média" => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8 12h8\"/>",
        _ => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 8v8M8.5 12.5 12 16l3.5-3.5\"/>"
    };

    // Traçados SVG (viewBox 24x24) por categoria; categoria desconhecida usa o ícone de caixa
    string IconeCategoria(string c) => c switch
    {
        "Alimentos" => "<path d=\"m5 11 4-7\"/><path d=\"m19 11-4-7\"/><path d=\"M2 11h20\"/><path d=\"m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4\"/>",
        "Roupas" => "<path d=\"M20.4 3.5 16 2a4 4 0 0 1-8 0L3.6 3.5a2 2 0 0 0-1.3 2.2l.6 3.5a1 1 0 0 0 1 .8H6v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10h2.2a1 1 0 0 0 1-.8l.6-3.5a2 2 0 0 0-1.4-2.2z\"/>",
        "Saúde" => "<path d=\"M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z\"/>",
        "Material escolar" => "<path d=\"M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20\"/>",
        _ => "<path d=\"M21 8 12 3 3 8v8l9 5 9-5z\"/><path d=\"m3 8 9 5 9-5\"/><path d=\"M12 13v8\"/>"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/necessidade-index.css" asp-append-version="true" />
}

<div class="necessidades-page">
    <div class="necessidades-layout">
        <partial name="_MenuInstituicao" model="@("Necessidades")" />

        <main class="necessidades-main">
            <header class="necessidades-cabecalho">
                <div>
                    <h1>Necessidades</h1>
                    <p>Cadastre os itens que sua instituição precisa e mantenha os doadores informados sobre suas prioridades.</p>
                </div>
                <a asp-action="Create" class="btn-coral">+ Nova necessidade</a>
            </header>

            <section class="resumo-card" aria-label="Resumo">
                <span class="resumo-icone" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="16" rx="2" /><path d="M9 5V3.5h6V5" /><path d="M12 17.5s-3-1.8-3-3.9a1.7 1.7 0 0 1 3-1 1.7 1.7 0 0 1 3 1c0 2.1-3 3.9-3 3.9z" /></svg>
                </span>
                <div>
                    <strong>@totalAtivas</strong>
                    <span>@(totalAtivas == 1 ? "necessidade ativa" : "necessidades ativas")</span>
                </div>
            </section>

            <section class="filtros" aria-label="Filtros">
                <label class="filtro-busca">
                    <span class="visually-hidden">Buscar necessidade</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    <input type="search" id="filtroBusca" placeholder="Buscar necessidade..." autocomplete="off" />
                </label>

                <div class="filtro-chips" role="group" aria-label="Filtrar por prioridade">
                    <button type="button" class="chip" data-prioridade-filtro="todas" aria-pressed="true">Todas</button>
                    <button type="button" class="chip chip-alta" data-prioridade-filtro="alta" aria-pressed="false">Alta prioridade</button>
                    <button type="button" class="chip chip-media" data-prioridade-filtro="media" aria-pressed="false">Média prioridade</button>
                    <button type="button" class="chip chip-baixa" data-prioridade-filtro="baixa" aria-pressed="false">Baixa prioridade</button>
                </div>

                <label class="filtro-status">
                    <span class="visually-hidden">Filtrar por status</span>
                    <select id="filtroStatus">
                        <option value="todas">Todas</option>
                        <option value="ativa">Ativas</option>
                        <option value="inativa">Inativas</option>
                    </select>
                </label>
            </section>

            <section class="lista-necessidades" aria-label="Lista de necessidades">
                @foreach (var item in lista)
                {
                    var status = item.Ativa ? "ativa" : "inativa";
                    <article class="necessidade-card"
                             data-busca="@($"{item.Nome} {item.Categoria}".ToLowerInvariant())"
                             data-prioridade="@ClassePrioridade(item.Prioridade)"
                             data-status="@status">
                        <span class="card-icone" aria-hidden="true">
                            <svg viewBox="0 0 24 24">@Html.Raw(IconeCategoria(item.Categoria))</svg>
                        </span>

                        <div class="card-info">
                            <h2><a asp-action="Details" asp-route-id="@item.Id">@item.Nome</a></h2>
                            <p class="card-categoria">@item.Categoria</p>
                            @if (!string.IsNullOrWhiteSpace(item.Descricao))
                            {
                                <p class="card-descricao">@item.Descricao</p>
                            }
                        </div>

                        <dl class="card-metas">
                            <dt>Prioridade</dt>
                            <dd><span class="badge-prioridade prio-@ClassePrioridade(item.Prioridade)"><svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(IconePrioridade(item.Prioridade))</svg>@RotuloPrioridade(item.Prioridade)</span></dd>
                            <dt>Status</dt>
                            <dd><span class="badge-status status-@status">@(item.Ativa ? "Ativa" : "Inativa")</span></dd>
                        </dl>

                        <div class="card-acoes">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icone" aria-label="Editar @item.Nome" title="Editar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                            </a>
                            <button type="button" class="btn-icone btn-icone-perigo" aria-label="Excluir @item.Nome" title="Excluir"
                                    data-excluir
                                    data-id="@item.Id"
                                    data-acao="@Url.Action("Delete", new { id = item.Id })"
                                    data-nome="@item.Nome"
                                    data-categoria="@item.Categoria"
                                    data-status="@(item.Ativa ? "Ativa" : "Inativa")">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M6 6l1 14h10l1-14" /><path d="M10 11v6M14 11v6" /></svg>
                            </button>
                        </div>
                    </article>
                }

                <p id="semResultados" class="sem-resultados" @(lista.Count > 0 ? "hidden" : "")>
                    @(lista.Count == 0 ? "Nenhuma necessidade cadastrada ainda." : "Nenhuma necessidade encontrada com esses filtros.")
                </p>
            </section>
        </main>
    </div>
</div>

<dialog id="modalExcluir" class="modal-excluir" aria-labelledby="modalExcluirTitulo">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="Id" id="modalExcluirId" />

        <button type="button" class="modal-fechar" data-fechar aria-label="Fechar">&times;</button>

        <svg class="modal-alerta" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 7v6M12 17h.01" /></svg>
        <h2 id="modalExcluirTitulo">Excluir necessidade?</h2>
        <p>Essa necessidade será removida do perfil público da instituição.<br />Essa ação não poderá ser desfeita.</p>

        <div class="modal-resumo">
            <span class="card-icone" id="modalIcone" aria-hidden="true"></span>
            <div>
                <strong id="modalNome"></strong>
                <p id="modalCategoria"></p>
                <span class="modal-status-rotulo">Status</span>
                <span class="badge-status" id="modalStatus"></span>
            </div>
        </div>

        <div class="modal-botoes">
            <button type="button" class="btn-contorno" data-fechar>Cancelar</button>
            <button type="submit" class="btn-coral btn-com-icone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M6 6l1 14h10l1-14" /><path d="M10 11v6M14 11v6" /></svg>Excluir necessidade</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/necessidade-index.js" asp-append-version="true"></script>
}