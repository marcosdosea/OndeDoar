@model Models.NecessidadeViewModel

@{
    ViewData["Title"] = "Nova necessidade";
}

@section Styles {
    <link rel="stylesheet" href="~/css/necessidade-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/necessidade-form.css" asp-append-version="true" />
}

<div class="necessidades-page">
    <div class="necessidades-layout">
        <partial name="_MenuInstituicao" model="@("Necessidades")" />

        <main class="necessidades-main">
            <header class="necessidades-cabecalho">
                <div>
                    <h1>Nova necessidade</h1>
                    <p>Conte aos doadores o que sua instituição precisa neste momento.</p>
                </div>
                <span class="pill-visivel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>Visível para doadores</span>
            </header>

            <partial name="_FormNecessidade" model="Model" />
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/necessidade-form.js" asp-append-version="true"></script>
}