@model OndeDoarWeb.Models.AvaliacaoViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>AvaliacaoViewModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Nota" class="control-label"></label>
                <input asp-for="Nota" class="form-control" />
                <span asp-validation-for="Nota" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Comentario" class="control-label"></label>
                <input asp-for="Comentario" class="form-control" />
                <span asp-validation-for="Comentario" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Data" class="control-label"></label>
                <input type="date" asp-for="Data" class="form-control datepicker" />
                <span asp-validation-for="Data" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdInstituicao" class="control-label"></label>
                <input asp-for="IdInstituicao" class="form-control" />
                <span asp-validation-for="IdInstituicao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdDoador" class="control-label"></label>
                <input asp-for="IdDoador" class="form-control" />
                <span asp-validation-for="IdDoador" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
