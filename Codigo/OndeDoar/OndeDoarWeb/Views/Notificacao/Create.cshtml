@model OndeDoarWeb.Models.NotificacaoViewModel

@{
	ViewData["Title"] = "Nova Notificação";

	var valorInstituicao = Model.IdInstituicao > 0 ? Model.IdInstituicao.ToString() : "";
}

@section Styles {
	<link rel="stylesheet" href="~/css/notificacao-create.css" asp-append-version="true" />
}

<div class="criar-notificacao-page">
	<div class="notificacao-container">
		<a asp-action="Index" class="voltar-link">
			<span aria-hidden="true">&larr;</span> Voltar para Notificações
		</a>

		<h1 class="notificacao-titulo-principal">Nova Notificação</h1>
		<p class="notificacao-subtitulo">Avisar o doador com uma notificação.</p>

		<form asp-action="Create">
			<div class="criar-notificacao-layout">
				<div class="form-card">
					<div asp-validation-summary="ModelOnly" class="mensagem-erro"></div>

					<div class="campo-grupo">
						<label asp-for="Titulo" class="campo-rotulo">Título da Notificação</label>
						<input asp-for="Titulo" id="campoTitulo" class="campo-controle" maxlength="25" placeholder="Campanha do agasalho..." autocomplete="off" />
						<span asp-validation-for="Titulo" class="mensagem-erro"></span>
					</div>

					<div class="campo-grupo">
						<label asp-for="Descricao" class="campo-rotulo">Descrição</label>
						<textarea asp-for="Descricao" id="campoDescricao" class="campo-controle" maxlength="250" rows="6" placeholder="Conteúdo da Notificação"></textarea>
						<span asp-validation-for="Descricao" class="mensagem-erro"></span>
					</div>

					<div class="campo-grupo campo-grupo-curto">
						<label asp-for="IdInstituicao" class="campo-rotulo">Código da Instituição</label>
						<input asp-for="IdInstituicao" id="campoInstituicao" type="number" min="1" value="@valorInstituicao" class="campo-controle" placeholder="#123" />
						<span asp-validation-for="IdInstituicao" class="mensagem-erro"></span>
					</div>
				</div>

				<aside class="previa-card" aria-labelledby="previaTitulo">
					<div class="previa-cabecalho" id="previaTitulo">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
							<circle cx="12" cy="12" r="3" />
						</svg>
						Pré-visualização
					</div>

					<article class="previa-notificacao" aria-live="polite">
						<div class="previa-topo">
							<div class="notificacao-icone" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
									<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
									<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
								</svg>
							</div>
							<span class="notificacao-badge-instituicao" id="previaInstituicao">Instituição</span>
						</div>
						<h2 class="previa-titulo" id="previaTituloTexto">Título</h2>
						<p class="previa-descricao" id="previaDescricao">Descrição</p>
					</article>

					<p class="previa-dica"><strong>Dica:</strong> Seja direto no título, explique na mensagem.</p>
				</aside>
			</div>

			<div class="acoes-formulario">
				<a asp-action="Index" class="btn-cancelar">Cancelar</a>
				<button type="submit" class="btn-criar">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M22 2 11 13" />
						<path d="M22 2 15 22l-4-9-9-4 20-7z" />
					</svg>
					Criar Notificação
				</button>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const campoTitulo = document.getElementById("campoTitulo");
			const campoDescricao = document.getElementById("campoDescricao");
			const campoInstituicao = document.getElementById("campoInstituicao");

			const previaTitulo = document.getElementById("previaTituloTexto");
			const previaDescricao = document.getElementById("previaDescricao");
			const previaInstituicao = document.getElementById("previaInstituicao");

			function atualizar() {
				previaTitulo.textContent = campoTitulo.value.trim() || "Título";
				previaDescricao.textContent = campoDescricao.value.trim() || "Descrição";
				previaInstituicao.textContent = campoInstituicao.value
					? "Instituição #" + campoInstituicao.value
					: "Instituição";
			}

			[campoTitulo, campoDescricao, campoInstituicao].forEach(function (campo) {
				campo.addEventListener("input", atualizar);
			});

			atualizar();
		});
	</script>
}