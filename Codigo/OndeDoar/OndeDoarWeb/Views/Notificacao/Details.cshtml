@model OndeDoarWeb.Models.NotificacaoViewModel

@{
	ViewData["Title"] = "Detalhes da Notificação";

	var encontrada = Model.Id > 0;
}

@section Styles {
	<link rel="stylesheet" href="~/css/notificacao-details.css" asp-append-version="true" />
}

<div class="detalhes-notificacao-page">
	<div class="notificacao-container">
		<a asp-action="Index" class="voltar-link">
			<span aria-hidden="true">&larr;</span> Voltar para Notificações
		</a>

		@if (!encontrada) {
			<div class="detalhes-card detalhes-vazio">
				<div class="notificacao-icone" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
						<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
					</svg>
				</div>
				<h1 class="detalhes-titulo">Notificação Não Encontrada</h1>
				<p class="detalhes-texto-apoio">Não existe uma notificação com esse id.</p>
				<a asp-action="Index" class="btn-voltar">Ver todas as Notificações</a>
			</div>
		} else {
			<article class="detalhes-card">
				<header class="detalhes-topo">
					<div class="notificacao-icone" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
							<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
						</svg>
					</div>
					<div class="detalhes-meta">
						<span class="notificacao-badge-instituicao">Instituição #@Model.IdInstituicao</span>
						<span class="detalhes-codigo">Notificação #@Model.Id</span>
					</div>
				</header>

				<h1 class="detalhes-titulo">@Model.Titulo</h1>

				<div class="detalhes-divisor"></div>

				<p class="detalhes-descricao">@Model.Descricao</p>

				<footer class="detalhes-acoes">
					<a asp-action="Index" class="btn-voltar">Voltar para a Lista</a>
					<a asp-action="Delete" asp-route-id="@Model.Id" class="btn-excluir-outline">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M3 6h18" />
							<path d="M8 6V4h8v2" />
							<path d="M19 6l-1 14H6L5 6" />
							<path d="M10 11v6M14 11v6" />
						</svg>
						Excluir Notificação
					</a>
				</footer>
			</article>
		}
	</div>
</div>