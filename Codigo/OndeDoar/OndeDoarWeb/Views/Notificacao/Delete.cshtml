@model OndeDoarWeb.Models.NotificacaoViewModel

@{
	ViewData["Title"] = "Excluir Notificação";

	var encontrada = Model.Id > 0;
}

@section Styles {
	<link rel="stylesheet" href="~/css/notificacao-delete.css" asp-append-version="true" />
}

<div class="excluir-notificacao-page">
	<div class="excluir-container">

		@if (!encontrada) {
			<div class="excluir-card">
				<h1 class="excluir-titulo">Notificação Não Encontrada</h1>
				<p class="excluir-subtitulo">Não existe uma notificação com esse id.</p>
				<div class="excluir-acoes">
					<a asp-action="Index" class="btn-cancelar">Voltar para Notificações</a>
				</div>
			</div>
		} else {
			<div class="excluir-card" role="alertdialog" aria-labelledby="excluirTitulo" aria-describedby="excluirAviso">
				<div class="excluir-alerta" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10" />
						<path d="M12 7v6" />
						<path d="M12 17h.01" />
					</svg>
				</div>

				<h1 class="excluir-titulo" id="excluirTitulo">Excluir Notificação?</h1>
				<p class="excluir-subtitulo" id="excluirAviso">Esta notificação será removida da instituição.<br />Essa ação é permanente.</p>

				<div class="excluir-resumo">
					<div class="notificacao-icone" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
							<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
						</svg>
					</div>
					<div class="excluir-resumo-texto">
						<h2 class="excluir-notificacao-titulo">@Model.Titulo</h2>
						<span class="notificacao-badge-instituicao">Instituição #@Model.IdInstituicao</span>
						<p class="excluir-notificacao-descricao">@Model.Descricao</p>
					</div>
				</div>

				<form asp-action="Delete" method="post" class="excluir-acoes">
					<input type="hidden" asp-for="Id" />
					<a asp-action="Index" class="btn-cancelar">Cancelar</a>
					<button type="submit" class="btn-confirmar-exclusao">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M3 6h18" />
							<path d="M8 6V4h8v2" />
							<path d="M19 6l-1 14H6L5 6" />
							<path d="M10 11v6M14 11v6" />
						</svg>
						Excluir Notificação
					</button>
				</form>
			</div>
		}
	</div>
</div>