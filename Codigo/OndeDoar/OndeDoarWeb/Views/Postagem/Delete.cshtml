@model OndeDoarWeb.Models.PostagemViewModel

@{
    ViewData["Title"] = "Excluir Postagem";
}

@section Styles {
    <link rel="stylesheet" href="~/css/postagem-delete.css" asp-append-version="true" />
}

<div class="excluir-postagem-page">
    <div class="excluir-postagem-container">
        <div class="excluir-card">
            <div class="excluir-badge">Ação Irreversível</div>
            <h1 class="excluir-titulo">Excluir Postagem</h1>
            <p class="excluir-subtitulo">
                Tem certeza que deseja excluir esta campanha? Todos os dados abaixo serão removidos permanentemente.
            </p>

            <div class="excluir-resumo-box">
                <div class="excluir-meta">
                    <span class="postagem-badge-instituicao">Instituição #@Model.InstituicaoId</span>
                    <span>@Model.Data.ToString("dd/MM/yyyy")</span>
                </div>
                <h2 class="excluir-postagem-titulo">@Model.Titulo</h2>
                <p class="excluir-postagem-descricao">@Model.Descricao</p>
            </div>

            <form asp-action="Delete" method="post" class="excluir-acoes">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn-cancelar">Cancelar</a>
                <button type="submit" class="btn-confirmar-exclusao">Sim, Excluir</button>
            </form>
        </div>
    </div>
</div>